{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build", "^test:build"]
    },
    "test": {
      "dependsOn": ["^build", "build", "^test:build", "test:build"]
    },
    "test:build": {
      "dependsOn": ["^build", "build", "^test:build"],
      "outputs": [".test-dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "openapi:generate": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#lint:root": {}
  }
}
