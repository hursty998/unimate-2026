generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

enum AuthProvider {
  SUPABASE

  @@map("auth_provider")
  @@schema("app")
}

enum AuthorizationScopeKind {
  PLATFORM
  UNIVERSITY

  @@map("authorization_scope_kind")
  @@schema("app")
}

enum StoredObjectStatus {
  PENDING
  READY

  @@map("stored_object_status")
  @@schema("app")
}

enum PushProviderKind {
  EXPO

  @@map("push_provider_kind")
  @@schema("app")
}

enum PushPlatform {
  IOS
  ANDROID

  @@map("push_platform")
  @@schema("app")
}

enum PushRegistrationStatus {
  ACTIVE
  DISABLED

  @@map("push_registration_status")
  @@schema("app")
}

enum PushDeliveryStatus {
  SUBMITTED
  RECEIPT_ACCEPTED
  INVALID_TOKEN
  REJECTED
  SKIPPED_DISABLED

  @@map("push_delivery_status")
  @@schema("app")
}

model User {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  authIdentities         AuthIdentity[]
  pushRegistrations      PushRegistration[]
  storedObjects          StoredObject[]
  universityAffiliations UniversityAffiliation[]
  roleAssignments        RoleAssignment[]
  capabilityAssignments  CapabilityAssignment[]

  @@map("users")
  @@schema("app")
}

model StoredObject {
  id            String             @id @default(uuid(7)) @db.Uuid
  objectKey     String             @unique @map("object_key")
  creatorUserId String             @map("creator_user_id") @db.Uuid
  contentType   String             @map("content_type")
  status        StoredObjectStatus @default(PENDING)
  sizeBytes     Int?               @map("size_bytes")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(6)
  creator       User               @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)

  @@index([creatorUserId])
  @@map("stored_objects")
  @@schema("app")
}

model AuthIdentity {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
  @@schema("app")
}

model University {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  universityAffiliations UniversityAffiliation[]
  roleAssignments        RoleAssignment[]
  capabilityAssignments  CapabilityAssignment[]

  @@map("universities")
  @@schema("app")
}

model UniversityAffiliation {
  id           String     @id @default(uuid(7)) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  universityId String     @map("university_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  @@unique([userId, universityId])
  @@index([universityId])
  @@map("university_affiliations")
  @@schema("app")
}

model Role {
  id           String                 @id @default(uuid(7)) @db.Uuid
  key          String
  name         String
  description  String?
  scopeKind    AuthorizationScopeKind @map("scope_kind")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  capabilities RoleCapability[]
  assignments  RoleAssignment[]

  @@unique([id, scopeKind])
  @@unique([scopeKind, key])
  @@map("roles")
  @@schema("app")
}

model RoleCapability {
  roleId     String   @map("role_id") @db.Uuid
  capability String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, capability])
  @@map("role_capabilities")
  @@schema("app")
}

model RoleAssignment {
  id           String                 @id @default(uuid(7)) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  roleId       String                 @map("role_id") @db.Uuid
  scopeKind    AuthorizationScopeKind @map("scope_kind")
  universityId String?                @map("university_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId, scopeKind], references: [id, scopeKind], onDelete: Cascade)
  university   University?            @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([userId, scopeKind, universityId, roleId])
  @@index([roleId])
  @@index([universityId])
  @@map("role_assignments")
  @@schema("app")
}

model CapabilityAssignment {
  id           String                 @id @default(uuid(7)) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  capability   String
  scopeKind    AuthorizationScopeKind @map("scope_kind")
  universityId String?                @map("university_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University?            @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([userId, scopeKind, universityId, capability])
  @@index([universityId])
  @@map("capability_assignments")
  @@schema("app")
}

model OutboxMessage {
  id             String    @id @default(uuid(7)) @db.Uuid
  eventType      String    @map("event_type")
  payloadVersion Int       @default(1) @map("payload_version")
  payload        Json      @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt, id])
  @@map("outbox_messages")
  @@schema("app")
}

model FoundationAsyncTask {
  id          String    @id @default(uuid(7)) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@map("foundation_async_tasks")
  @@schema("app")
}

model PushRegistration {
  id               String                  @id @default(uuid(7)) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  provider         PushProviderKind
  platform         PushPlatform
  providerToken    String                  @map("provider_token")
  status           PushRegistrationStatus  @default(ACTIVE)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAttempts PushDeliveryAttempt[]

  @@index([userId, status])
  @@map("push_registrations")
  @@schema("app")
}

model PushDeliveryAttempt {
  id                     String             @id @default(uuid(7)) @db.Uuid
  sourceJobId            String             @unique @map("source_job_id") @db.Uuid
  registrationId         String             @map("registration_id") @db.Uuid
  submissionHandle       String?            @map("submission_handle")
  status                 PushDeliveryStatus
  receiptCheckScheduledAt DateTime?          @map("receipt_check_scheduled_at") @db.Timestamptz(6)
  receiptCheckedAt       DateTime?           @map("receipt_checked_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  registration           PushRegistration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("push_delivery_attempts")
  @@schema("app")
}
