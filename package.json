{
  "name": "unimate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint eslint.config.mjs scripts",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:tooling && turbo run test",
    "test:tooling": "node --test scripts/*.test.mjs",
    "openapi:generate": "turbo run openapi:generate --filter=@unimate/api",
    "format": "prettier --write . && pnpm --filter @unimate/database format",
    "format:check": "prettier --check .",
    "verify:changed": "pnpm format:check && pnpm test:tooling && turbo run lint lint:root typecheck build test --affected",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm openapi:generate && pnpm test && pnpm db:check && pnpm db:test && pnpm auth:test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:generate": "pnpm --filter @unimate/database generate",
    "db:migrate": "pnpm --filter @unimate/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @unimate/database migrate:deploy",
    "db:reset": "pnpm --filter @unimate/database reset:local",
    "db:seed": "pnpm --filter @unimate/database seed",
    "db:check": "pnpm --filter @unimate/database check",
    "db:test": "pnpm --filter @unimate/database test:integration",
    "auth:test": "pnpm exec turbo run build --filter=@unimate/api && node --env-file-if-exists=packages/database/.env --env-file-if-exists=apps/api/.env scripts/auth-test.mjs",
    "git-diff": "node scripts/git-diff.mjs"
  },
  "devDependencies": {
    "@unimate/eslint-config": "workspace:*",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
