{
  "name": "unimate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint eslint.config.mjs scripts",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:tooling && turbo run test",
    "test:tooling": "node --test scripts/*.test.mjs",
    "openapi:generate": "turbo run openapi:generate --filter=@unimate/api",
    "openapi:generate:prepared": "pnpm --filter @unimate/api openapi:generate:prepared",
    "format": "prettier --write . && pnpm --filter @unimate/database format",
    "format:check": "prettier --check .",
    "verify:changed": "node scripts/verify.mjs --changed",
    "verify": "node scripts/verify.mjs",
    "verify:verbose": "node scripts/verify.mjs --verbose",
    "secrets:check": "node scripts/secrets-check.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:generate": "pnpm --filter @unimate/database generate",
    "db:migrate": "pnpm --filter @unimate/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @unimate/database migrate:deploy",
    "db:reset": "pnpm --filter @unimate/database reset:local",
    "db:seed": "pnpm --filter @unimate/database seed",
    "db:check": "pnpm --filter @unimate/database check",
    "db:check:prepared": "pnpm --filter @unimate/database check:prepared",
    "db:test": "pnpm --filter @unimate/database test:integration",
    "db:test:prepared": "pnpm --filter @unimate/database test:integration:prepared",
    "auth:test": "pnpm exec turbo run build --filter=@unimate/api && pnpm auth:test:prepared",
    "auth:test:prepared": "node --env-file-if-exists=packages/database/.env --env-file-if-exists=apps/api/.env scripts/auth-test.mjs",
    "storage-proof:test": "pnpm --filter @unimate/api... build && pnpm storage-proof:test:prepared",
    "storage-proof:test:prepared": "node --env-file-if-exists=packages/database/.env scripts/storage-proof-test.mjs",
    "push:test": "pnpm --filter @unimate/api... build && pnpm push:test:prepared",
    "push:test:prepared": "node --env-file-if-exists=packages/database/.env --test apps/api/dist/modules/push/push.integration.test.js",
    "authorization:test": "pnpm exec turbo run build --filter=@unimate/api && pnpm authorization:test:prepared",
    "authorization:test:prepared": "node --env-file-if-exists=packages/database/.env scripts/authorization-test.mjs",
    "providers:test": "pnpm exec turbo run build test --filter=@unimate/storage --filter=@unimate/queue --filter=@unimate/notifications --filter=@unimate/observability --output-logs=errors-only && pnpm providers:test:prepared",
    "providers:test:prepared": "node scripts/providers-test.mjs",
    "worker:test": "pnpm db:generate && pnpm exec turbo run build test --filter=@unimate/worker --output-logs=errors-only && pnpm worker:test:prepared",
    "worker:test:prepared": "node --env-file-if-exists=packages/database/.env scripts/worker-test.mjs",
    "observability:test": "pnpm db:generate && pnpm exec turbo run build --filter=@unimate/api --filter=@unimate/worker --output-logs=errors-only && node --env-file-if-exists=packages/database/.env --env-file-if-exists=apps/api/.env scripts/observability-test.mjs",
    "observability:test:prepared": "node --env-file-if-exists=packages/database/.env --env-file-if-exists=apps/api/.env scripts/observability-test.mjs --prepared",
    "git-diff": "node scripts/git-diff.mjs"
  },
  "devDependencies": {
    "@unimate/eslint-config": "workspace:*",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
