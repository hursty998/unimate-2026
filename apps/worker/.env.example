# Use the local URLs from packages/database/.env; the queue connection is explicit.
DATABASE_URL="postgresql://postgres:replace@127.0.0.1:55322/postgres"
QUEUE_DATABASE_URL="postgresql://postgres:replace@127.0.0.1:55322/postgres"
QUEUE_NAME="unimate_foundation_jobs"
QUEUE_VISIBILITY_TIMEOUT_SECONDS="30"
WORKER_BATCH_SIZE="10"
WORKER_MAX_DELIVERY_ATTEMPTS="5"
WORKER_POLL_INTERVAL_MS="1000"
FOUNDATION_PUSH_RECEIPT_CHECK_DELAY_SECONDS="900"
