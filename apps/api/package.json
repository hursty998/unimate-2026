{
  "name": "@unimate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-workspace-tests.mjs dist",
    "openapi:generate": "node dist/generate-openapi.js",
    "openapi:check:prepared": "node dist/check-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@opentelemetry/api": "1.9.1",
    "@orpc/nest": "1.15.5",
    "@orpc/openapi": "1.15.5",
    "@orpc/server": "1.15.5",
    "@orpc/zod": "1.15.5",
    "@unimate/auth": "workspace:*",
    "@unimate/authorization": "workspace:*",
    "@unimate/contracts": "workspace:*",
    "@unimate/database": "workspace:*",
    "@unimate/jobs": "workspace:*",
    "@unimate/observability": "workspace:*",
    "@unimate/storage": "workspace:*",
    "fastify": "5.12.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
