API_HOST=0.0.0.0
API_PORT=3000
NODE_ENV=development
API_CORS_ORIGINS=

# Copy the local runtime URL from packages/database/.env.example.
DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_JWT_AUDIENCE=authenticated
# Server-only Storage credential; obtain locally from `supabase status -o json`.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=foundation-storage-proof
