# Leave blank to use the platform-specific local development address.
# Physical devices require an API address reachable from that device.
EXPO_PUBLIC_API_URL=

# The Supabase URL can be overridden for physical devices and non-local stacks.
EXPO_PUBLIC_SUPABASE_URL=
# Use only the public sb_publishable_ key; never a secret/service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
